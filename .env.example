# Copy this file to .env for local development and replace the placeholder.
DJANGO_SECRET_KEY=replace-with-your-own-secret-key
DJANGO_DEBUG=1
HUNTALPHA_ALLOWED_HOSTS=127.0.0.1,localhost
HUNTALPHA_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173
HUNTALPHA_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
HUNTALPHA_DATABASE_PATH=
HUNTALPHA_STATIC_ROOT=
HUNTALPHA_MEDIA_ROOT=
HUNTALPHA_SESSION_COOKIE_SECURE=0
HUNTALPHA_CSRF_COOKIE_SECURE=0
HUNTALPHA_TRUST_PROXY=0
HUNTALPHA_SECURE_SSL_REDIRECT=0
HUNTALPHA_HSTS_SECONDS=0

# Public market data is the default and needs no credentials:
# Yahoo Finance, Tencent public quotes, and Coinbase public market data.
# These private providers are optional enhancements only.
TUSHARE_TOKEN=replace-with-your-tushare-token
LONGBRIDGE_APP_KEY=replace-with-your-longbridge-app-key
LONGBRIDGE_APP_SECRET=replace-with-your-longbridge-app-secret
LONGBRIDGE_ACCESS_TOKEN=replace-with-your-longbridge-access-token
# Default real-time markets are hk,us; add cn only after Longbridge A-share permission is verified.
LONGBRIDGE_MARKETS=hk,us
# Tushare A-share real-time/near-real-time polling interval in seconds.
TUSHARE_REALTIME_POLL_SECONDS=5
# Public stock quote polling interval in seconds.
PUBLIC_REALTIME_POLL_SECONDS=15

# Email verification: real Brevo key must be stored on the server, never in Git.
HUNTALPHA_VERIFICATION_FROM_EMAIL=no-reply@siftalpha.com
BREVO_API_KEY=replace-with-private-server-side-key
# Only set to 1 when CF-Connecting-IP is verified to come from the trusted proxy.
HUNTALPHA_TRUST_CLOUDFLARE_IP=0
